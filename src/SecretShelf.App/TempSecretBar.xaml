<UserControl x:Class="SecretShelf.App.TempSecretBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Временный секрет: одна передача ключа между владельцем и агентом мимо переписки -->
    <Border x:Name="Frame" CornerRadius="8" BorderThickness="1" Padding="12,9,12,10" Margin="10,2,6,8"
            Background="{StaticResource Card}" BorderBrush="{StaticResource LineStrong}">
        <StackPanel>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HeadIcon" FontFamily="{StaticResource Icons}" FontSize="13" Text="&#xE8AB;"
                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                <TextBlock x:Name="HeadText" Grid.Column="1" Text="Временный секрет" FontSize="13" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Grid.Column="2" FontSize="11.5" Foreground="{StaticResource TextDim}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>

            <!-- Пусто: поле для вставки -->
            <StackPanel x:Name="EmptyBox">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="PasteBox" FontFamily="{StaticResource Mono}" FontSize="12.5"
                                 PasswordChanged="PasteBox_PasswordChanged" KeyDown="PasteBox_KeyDown"/>
                    <TextBlock x:Name="PastePlaceholder" Style="{StaticResource Placeholder}" Text="Вставьте ключ для агента"/>
                    <Button x:Name="PasteCommit" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE8FB;"
                            Width="30" Height="28" Margin="4,0,0,0" FontSize="13" Visibility="Collapsed"
                            ToolTip="Передать агенту (Enter)" Click="PasteCommit_Click"/>
                </Grid>
                <TextBlock Text="Одна передача: агент заберёт — значение сотрётся" FontSize="11"
                           Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Лежит значение: точки или само значение, кнопки -->
            <StackPanel x:Name="FilledBox" Visibility="Collapsed">
                <TextBlock x:Name="ValueText" FontFamily="{StaticResource Mono}" FontSize="12.5"
                           Foreground="{StaticResource TextDim}" TextWrapping="Wrap" MaxHeight="90"/>
                <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="CopyButton" Style="{StaticResource PrimaryButton}" Padding="10,4" FontSize="12"
                            Margin="0,0,6,0" Click="Copy_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8C8;" Margin="0,1,6,0"/>
                            <TextBlock Text="Копировать"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ShowButton" Style="{StaticResource TextButton}" Padding="10,4" FontSize="12"
                            Margin="0,0,6,0" Click="Show_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE890;" Margin="0,1,6,0"/>
                            <TextBlock x:Name="ShowLabel" Text="Показать"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveButton" Style="{StaticResource TextButton}" Padding="10,4" FontSize="12"
                            Margin="0,0,6,0" Click="Save_Click" ToolTip="Сохранить постоянной записью шторки">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE74E;" Margin="0,1,6,0"/>
                            <TextBlock Text="В запись"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ClearButton" Style="{StaticResource TextButton}" Padding="10,4" FontSize="12"
                            Click="Clear_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE711;" Margin="0,1,6,0"/>
                            <TextBlock Text="Стереть"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
