<Window x:Class="SecretShelf.App.PeekWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SecretShelf" Width="22" Height="48"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False">
    <!-- Язычок свёрнутой шторки: правый нижний угол над панелью задач. -->
    <Border x:Name="Tab" Background="#E62A2D34" CornerRadius="8,0,0,8" BorderBrush="#353943" BorderThickness="1,1,0,1"
            Cursor="Hand" ToolTip="Открыть SecretShelf" MouseLeftButtonUp="Tab_Click">
        <TextBlock x:Name="Arrow" Text="&#xE76B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                   Foreground="#8B909C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <Window.Triggers>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <ColorAnimation Storyboard.TargetName="Tab" Storyboard.TargetProperty="Background.Color"
                                    To="#FF3A3F49" Duration="0:0:0.12"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <ColorAnimation Storyboard.TargetName="Tab" Storyboard.TargetProperty="Background.Color"
                                    To="#E62A2D34" Duration="0:0:0.2"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>
