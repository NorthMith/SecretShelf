<UserControl x:Class="SecretShelf.App.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="10,0,0,4">
            <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Назад (Esc)" Click="Back_Click"/>
            <TextBlock Text="Импорт из браузера" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,0,14,0">
            <StackPanel Margin="0,4,4,10">
                <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource TextDim}"
                           Text="Выгрузите пароли из браузера в файл CSV. Chrome: в адресной строке chrome://password-manager/settings → «Экспорт паролей». Firefox: about:logins → меню «⋯» справа вверху → «Экспорт паролей». Edge — в разделе паролей его настроек."/>

                <Button Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Pick_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource Icons}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Выбрать файл CSV…"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="FileText" FontFamily="{StaticResource Mono}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>

                <StackPanel x:Name="PreviewBlock" Visibility="Collapsed">
                    <TextBlock x:Name="SummaryText" FontSize="13" Margin="0,8,0,6"/>
                    <ItemsControl x:Name="PreviewList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" FontSize="12" TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding Brush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Login}" FontSize="12" FontFamily="{StaticResource Mono}"
                                               TextTrimming="CharacterEllipsis" Foreground="{Binding Brush}" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="MoreText" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                    <TextBlock Text="Каждая запись: Логин · Пароль (скрыт) · Адрес" FontSize="11.5"
                               Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"/>
                </StackPanel>

                <Border Background="{StaticResource WarnBg}" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource WarnText}"
                               Text="В CSV пароли лежат открытым текстом. После импорта удалите файл — здесь будет кнопка."/>
                </Border>

                <!-- после импорта -->
                <StackPanel x:Name="DoneBlock" Visibility="Collapsed" Margin="0,12,0,0">
                    <TextBlock x:Name="DoneText" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ok}"/>
                    <Button x:Name="DeleteCsvButton" Style="{StaticResource DangerButton}" HorizontalAlignment="Left"
                            Padding="0,8" Click="DeleteCsv_Click" Content="Удалить файл CSV"/>
                    <TextBlock x:Name="DeleteText" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource TextDim}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,8,14,12">
            <Button x:Name="CancelButton" Style="{StaticResource TextButton}" Content="Отмена" Margin="0,0,8,0" Click="Back_Click"/>
            <Button x:Name="ImportButton" Style="{StaticResource PrimaryButton}" Content="Добавить" IsEnabled="False"
                    Click="Import_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
