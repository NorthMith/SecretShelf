<Window x:Class="SecretShelf.App.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SecretShelf — запрос агента" Icon="Assets/secretshelf.ico" Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True"
        FontFamily="Segoe UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- Запрос ИИ-агента к ключам: что, каким ключом, команда целиком. Нет ответа 60 с — отказ. -->
    <Border x:Name="Frame" Background="{StaticResource Bg}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
            CornerRadius="12" Padding="16,14" Margin="8" TextElement.Foreground="{StaticResource Text}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.25"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="HeaderIcon" Text="&#xE99A;" FontFamily="{StaticResource Icons}" FontSize="16"
                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="320"/>
            </StackPanel>
            <TextBlock x:Name="ClientText" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,4,0,10" TextWrapping="Wrap"/>

            <TextBlock x:Name="SecretsLabel" Text="Ключи" FontSize="12" Foreground="{StaticResource TextDim}"/>
            <TextBlock x:Name="SecretsText" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,8"/>

            <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="8,6">
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="DetailsText" FontFamily="{StaticResource Mono}" FontSize="12" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

            <TextBlock x:Name="TrustHint" FontSize="11.5" Foreground="{StaticResource TextDim}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="«Доверять 1 час»: эта сессия агента сможет подставлять и добавлять ключи без окна. Удаление и поиск по папкам — всё равно с окном. Сбрасывается при блокировке шторки."/>

            <TextBlock x:Name="CountdownText" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,10,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button x:Name="DenyButton" Style="{StaticResource TextButton}" Content="Отказать" Margin="0,0,8,0"
                        IsCancel="True" Click="Deny_Click"/>
                <Button x:Name="TrustButton" Style="{StaticResource TextButton}" Content="Доверять 1 час" Margin="0,0,8,0"
                        Click="Trust_Click"/>
                <Button x:Name="AllowButton" Style="{StaticResource PrimaryButton}" Content="Разрешить" Click="Allow_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
