<UserControl x:Class="SecretShelf.App.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="10,0,0,4">
            <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Назад к списку (Esc)" Click="Back_Click"/>
            <TextBlock Text="Настройки" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,0,14,0">
            <StackPanel Margin="0,0,4,16">

                <!-- ===== Вход ===== -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Вход" Margin="0,4,0,4"/>
                <Grid Margin="0,2">
                    <TextBlock Text="Мастер-пароль" VerticalAlignment="Center" FontSize="13"/>
                    <Button x:Name="ChangePassButton" Style="{StaticResource TextButton}" Content="Сменить"
                            HorizontalAlignment="Right" Padding="10,4" FontSize="12" Click="ChangePassToggle_Click"/>
                </Grid>
                <Border x:Name="ChangePassBlock" Visibility="Collapsed" Background="{StaticResource Card}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Text="Текущий пароль" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,0,0,3"/>
                        <PasswordBox x:Name="OldPass"/>
                        <TextBlock Text="Новый пароль" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,8,0,3"/>
                        <PasswordBox x:Name="NewPass1"/>
                        <TextBlock Text="Новый ещё раз" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,8,0,3"/>
                        <PasswordBox x:Name="NewPass2"/>
                        <TextBlock x:Name="ChangePassMessage" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Style="{StaticResource TextButton}" Content="Отмена" Padding="10,5" Margin="0,0,6,0"
                                    Click="ChangePassToggle_Click"/>
                            <Button x:Name="ChangePassSave" Style="{StaticResource PrimaryButton}" Content="Сменить пароль"
                                    Padding="10,5" Click="ChangePassSave_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Быстрый вход" FontSize="13" Margin="0,10,0,4"/>
                <StackPanel IsEnabled="False">
                    <RadioButton Content="Только мастер-пароль" IsChecked="True" Margin="0,2"/>
                    <RadioButton Content="Windows Hello (отпечаток, лицо, ПИН Windows)" Margin="0,2"/>
                    <RadioButton Content="ПИН-код SecretShelf" Margin="0,2"/>
                    <RadioButton Content="Без пароля" Margin="0,2"/>
                </StackPanel>
                <TextBlock Text="Отпечаток, ПИН и вход без пароля появятся в следующем обновлении."
                           TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="11.5" Margin="0,4,0,0"/>

                <!-- ===== Блокировка ===== -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Блокировка"/>
                <Grid Margin="0,2">
                    <TextBlock Text="Без действий" VerticalAlignment="Center" FontSize="13"/>
                    <ComboBox x:Name="IdleBox" HorizontalAlignment="Right" Width="130" SelectionChanged="Idle_Changed"/>
                </Grid>
                <TextBlock Text="Считается бездействие всего компьютера, а не только шторки."
                           TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="11.5" Margin="0,2,0,2"/>
                <CheckBox x:Name="LockOnSessionBox" Style="{StaticResource Switch}" Content="При Win+L и сне"
                          Click="Toggle_Click"/>

                <!-- ===== Вызов шторки ===== -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Вызов шторки"/>
                <CheckBox x:Name="PeekBox" Style="{StaticResource Switch}" Content="Язычок справа внизу" Click="Toggle_Click"/>
                <CheckBox x:Name="TrayBox" Style="{StaticResource Switch}" Content="Значок в трее" Click="Toggle_Click"/>
                <Grid Margin="0,4">
                    <TextBlock Text="Горячая клавиша" VerticalAlignment="Center" FontSize="13"/>
                    <Button x:Name="HotkeyButton" Style="{StaticResource TextButton}" HorizontalAlignment="Right"
                            Padding="10,4" FontSize="12" MinWidth="110" Focusable="True"
                            ToolTip="Щёлкните и нажмите новое сочетание. Backspace — выключить, Esc — отмена."
                            Click="Hotkey_Click" PreviewKeyDown="Hotkey_PreviewKeyDown" LostKeyboardFocus="Hotkey_LostFocus"/>
                </Grid>
                <TextBlock x:Name="CallMessage" TextWrapping="Wrap" Foreground="{StaticResource Danger}" FontSize="11.5"/>
                <CheckBox x:Name="HideOnDeactivateBox" Style="{StaticResource Switch}" Content="Прятать при щелчке мимо"
                          Click="Toggle_Click"/>
                <CheckBox x:Name="AutostartBox" Style="{StaticResource Switch}" Content="Запуск с Windows"
                          Click="Autostart_Click"/>

                <!-- ===== Буфер обмена ===== -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Буфер обмена"/>
                <Grid Margin="0,2">
                    <TextBlock Text="Очищать через" VerticalAlignment="Center" FontSize="13"/>
                    <ComboBox x:Name="ClipboardBox" HorizontalAlignment="Right" Width="130" SelectionChanged="Clipboard_Changed"/>
                </Grid>

                <!-- ===== Данные ===== -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Данные"/>
                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" IsEnabled="False"
                        ToolTip="Появится в следующем обновлении">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B5;" FontFamily="{StaticResource Icons}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Импорт из браузера (CSV) — скоро" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Click="OpenFolder_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource Icons}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Папка хранилища и копий"/>
                    </StackPanel>
                </Button>

                <Border Height="1" Background="{StaticResource Line}" Margin="0,16,0,10"/>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource TextButton}" Padding="10,5" FontSize="12" Margin="0,0,8,0" Click="Lock_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Заблокировать"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource TextButton}" Padding="10,5" FontSize="12" Click="Exit_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Icons}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Выйти из SecretShelf"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="KdfInfo" Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap"
                           Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
