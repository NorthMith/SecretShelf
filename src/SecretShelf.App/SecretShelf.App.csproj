<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SecretShelf.Core\SecretShelf.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041: API Windows Hello (KeyCredentialManager) -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms нужен только ради NotifyIcon (значок в трее) -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SecretShelf</AssemblyName>
    <ApplicationIcon>Assets\secretshelf.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\secretshelf.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Иначе Application, Button, Clipboard и др. станут неоднозначными между WPF и WinForms -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
