<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SecretShelf.Core\SecretShelf.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms нужен только ради NotifyIcon (значок в трее) -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SecretShelf</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Иначе Application, Button, Clipboard и др. станут неоднозначными между WPF и WinForms -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
