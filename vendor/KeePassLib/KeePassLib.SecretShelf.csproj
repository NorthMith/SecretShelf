<Project Sdk="Microsoft.NET.Sdk">
  <!-- KeePassLib 2.61.1 (keepass.info, SHA-256 архива сверен), собранный под .NET 8.
       Исходники ядра не правим без нужды: так проще обновляться. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>KeePassLib</AssemblyName>
    <RootNamespace>KeePassLib</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0618;SYSLIB0001;SYSLIB0011;SYSLIB0021;SYSLIB0022;SYSLIB0023;SYSLIB0041;SYSLIB0045;SYSLIB0003;SYSLIB0006;SYSLIB0014;CA1416;CS8981;WFO1000</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
